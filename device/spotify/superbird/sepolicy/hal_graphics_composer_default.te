# The HWC (hwcomposer/hwcomposer.cpp) reads the panel size and frame rate from
# /sys/class/display/vinfo. AOSP allows /dev/graphics/fb0 and CAP_SYS_NICE.
allow hal_graphics_composer_default sysfs_cpt_display:dir r_dir_perms;
allow hal_graphics_composer_default sysfs_cpt_display:file r_file_perms;
# The AOSP composer service (hardware/interfaces/graphics/composer/2.1/default/service.cpp)
# opens /dev/vndbinder and sets SCHED_FIFO for its main thread; this kernel checks the second
# against the kernel domain. Android 9 policy has neither rule.
vndbinder_use(hal_graphics_composer_default)
allow hal_graphics_composer_default kernel:process setsched;

# vold checks each loop device at start (Loop::destroyAll, LOOP_GET_STATUS64); the kernel
# then reads the attributes of the backing file. For /data that is our image on the stock
# data partition (data-setup.sh). vold leaves the device alone (not "vold#"), but without
# this rule the denial comes at each boot.
allow vold cpt_stock_data_file:file getattr;

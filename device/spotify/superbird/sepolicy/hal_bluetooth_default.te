# libbt-vendor reads the Broadcom patch file from the stock root file system
# (/mnt/vendor/stock-root/lib/firmware/brcm, init.superbird.rc).
allow hal_bluetooth_default mnt_vendor_file:dir search;
allow hal_bluetooth_default cpt_stock_root_file:dir r_dir_perms;
allow hal_bluetooth_default cpt_stock_root_file:file r_file_perms;

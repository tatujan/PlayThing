# gralloc reads the frame buffer attributes in /sys/class/graphics/fb0.
allow hal_graphics_allocator_default sysfs_cpt_display:dir r_dir_perms;
allow hal_graphics_allocator_default sysfs_cpt_display:file r_file_perms;

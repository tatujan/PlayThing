<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.plaything.manager">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
    <!-- Signature permissions: the app has the platform key (Android.mk). -->
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNAL_DELETE_CACHE_FILES" />
    <uses-permission android:name="android.permission.CLEAR_APP_USER_DATA" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/ManagerTheme"
        android:allowBackup="false">
        <activity
            android:name=".ManagerActivity"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

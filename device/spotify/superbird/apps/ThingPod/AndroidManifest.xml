<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.plaything.pod">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
    <!-- The music files (also on USB sticks). Granted at the first start of a new /data
         (default-permissions-thingpod.xml), else the app asks once. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/PodTheme"
        android:allowBackup="false">
        <activity
            android:name=".PodActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity>
        <service
            android:name=".PlayerService"
            android:exported="false" />
    </application>
</manifest>

// H.264 decoder on the Amlogic hardware decoder (docs/video.md). SoftOMXPlugin loads
// it as libstagefright_soft_cpth264dec.so for "OMX.google.cpt.h264.decoder"
// (patches/aosp/frameworks/av/0003-*).
cc_library_shared {
    name: "libstagefright_soft_cpth264dec",

    srcs: ["SoftCptAVC.cpp"],

    cflags: [
        "-Wall",
        "-Werror",
    ],

    version_script: "exports.lds",

    include_dirs: [
        "frameworks/av/media/libstagefright/include",
        "frameworks/native/include/media/openmax",
    ],

    shared_libs: [
        "libcutils",
        "libion",
        "liblog",
        "libstagefright_foundation",
        "libstagefright_omx",
        "libutils",
    ],
}
